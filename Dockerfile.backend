# -------------------------------------------------------
# YouDub Backend - CUDA enabled (NVIDIA GPU required)
# Build:  docker build -f Dockerfile.backend -t youdub-backend .
# Run:    see docker-compose.yml
# -------------------------------------------------------
FROM nvidia/cuda:12.4.1-cudnn-runtime-ubuntu22.04

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

# System deps: Python 3.12 (deadsnakes PPA), FFmpeg, build tools
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        software-properties-common \
        ca-certificates \
        curl \
        git \
    && add-apt-repository ppa:deadsnakes/ppa \
    && apt-get update \
    && apt-get install -y --no-install-recommends \
        python3.12 \
        python3.12-venv \
        python3.12-dev \
        ffmpeg \
    && rm -rf /var/lib/apt/lists/* \
    && ln -sf /usr/bin/python3.12 /usr/local/bin/python3 \
    && python3 -m ensurepip --upgrade \
    && python3 -m pip install -U pip setuptools wheel

WORKDIR /app

# 1. Pre-install CUDA-enabled PyTorch BEFORE other Python deps.
#    This prevents pip from pulling CPU-only wheels later.
RUN python3 -m pip install --no-cache-dir \
    torch \
    torchaudio \
    --index-url https://download.pytorch.org/whl/cu124

# 2. Main project requirements (torch already satisfied, won't be replaced)
COPY requirements.txt ./
RUN python3 -m pip install --no-cache-dir \
    -i https://mirrors.aliyun.com/pypi/simple/ \
    -r requirements.txt

# 3. Demucs source submodule.
#    --no-deps avoids the torchaudio<2.1 cap in demucs requirements_minimal.txt
#    which conflicts with the modern torch/ torchaudio installed above.
#    demucs lightweight deps (einops, pyyaml, tqdm) are installed explicitly.
COPY submodule/demucs ./submodule/demucs
RUN python3 -m pip install --no-cache-dir --no-deps \
    -i https://mirrors.aliyun.com/pypi/simple/ \
    ./submodule/demucs \
    && python3 -m pip install --no-cache-dir \
    -i https://mirrors.aliyun.com/pypi/simple/ \
    einops pyyaml tqdm

# 4. Application code (copied last to leverage Docker layer caching)
COPY backend ./backend
COPY .env.example ./
RUN mkdir -p data/cookies data/logs data/modelscope workfolder

# PYTHONPATH lets `import backend.app...` resolve from /app
ENV PYTHONPATH=/app \
    DEVICE=cuda

EXPOSE 8000

CMD ["python3", "-m", "uvicorn", "backend.app.main:app", "--host", "0.0.0.0", "--port", "8000"]
